# Google Gemini API Key - Get yours from https://aistudio.google.com/
# Copy this file to '.env' and fill in your actual API Key.
# Do NOT commit your actual '.env' file to GitHub!
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred model (e.g., gemini-2.5-flash or gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-flash
